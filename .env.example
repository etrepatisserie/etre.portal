# Copy to .env.dev (development), .env.uat or .env.production — all are git-ignored.
# The server picks the file from NODE_ENV (npm run server:dev / server:uat / server:prod); .env is a fallback.

NODE_ENV=development
PORT=3001
# Address the portal is opened from (CORS + links in emails). The API also serves the built client itself.
APP_URL=http://localhost:5173
# Extra browser origins allowed to call the API, comma separated (optional)
# CORS_ORIGINS=
# Where the built React client is (default: client/build)
# CLIENT_BUILD_PATH=

# MySQL (tables: sql/schema.sql, starting data: sql/seed.sql — run both once on an empty database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=etre_portal

# Password given to the seeded logins when an empty database is set up (stored hashed). Change each login's password after the first sign-in.
INITIAL_PASSWORD=


# Email: "log" (development — saved to Admin › Email Outbox + console) or "smtp" (really send)
EMAIL_MODE=log
EMAIL_FROM="Être Patisserie <orders@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Each company sends from its own mailbox (address set in Admin › Settings › Company email).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, and an app password per account
# (Google Account › Security › 2-Step Verification › App passwords).
SMTP_KL_USER=
SMTP_KL_PASS=
SMTP_IPH_USER=
SMTP_IPH_PASS=

# Optional override (uploads folder)
# UPLOAD_DIR=server/uploads

# Bukku accounting (one Bukku company per outlet). Leave BUKKU_ENABLED unset until tested with a test company.
# Token: Bukku → Control Panel → Integrations → API Access. Never commit real values.
# BUKKU_ENABLED=1
# BUKKU_BASE_URL=https://api.bukku.my
# BUKKU_KL_TOKEN=
# BUKKU_KL_SUBDOMAIN=
# BUKKU_IPH_TOKEN=
# BUKKU_IPH_SUBDOMAIN=
